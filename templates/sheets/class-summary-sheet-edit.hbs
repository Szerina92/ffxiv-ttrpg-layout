<div class="ffxiv-class-summary-editor">
  <section class="ffxiv-editor-page-settings ffxiv-class-summary-editor__page-settings">
    <div class="ffxiv-editor-page-settings-title ffxiv-class-summary-editor__page-settings-title">
      <label
        class="ffxiv-editor-page-setting ffxiv-editor-page-setting--icon ffxiv-class-summary-editor__page-setting ffxiv-class-summary-editor__page-setting--icon"
        for="ffxiv-class-summary-page-title"
        title="{{localize 'FFXIVTTRPGLayout.ClassSummary.PageTitle'}}"
        aria-label="{{localize 'FFXIVTTRPGLayout.ClassSummary.PageTitle'}}">
        <i class="fa-solid fa-book" aria-hidden="true"></i>
      </label>
      <input
        id="ffxiv-class-summary-page-title"
        type="text"
        name="name"
        value="{{pageTitle}}"
        autocomplete="off"
      >
    </div>

    <div class="ffxiv-editor-page-settings-controls ffxiv-class-summary-editor__page-settings-controls">
      {{#if hasCategories}}
        <label
          class="ffxiv-editor-page-setting ffxiv-editor-page-setting--icon ffxiv-class-summary-editor__page-setting ffxiv-class-summary-editor__page-setting--icon"
          title="{{localize 'FFXIVTTRPGLayout.ClassSummary.Category'}}"
          aria-label="{{localize 'FFXIVTTRPGLayout.ClassSummary.Category'}}">
          <i class="fa-solid fa-layer-group" aria-hidden="true"></i>
          <select name="category">
            <option value="" {{#if isUncategorized}}selected{{/if}}>{{noCategoryLabel}}</option>
            {{#each categories}}
              <option value="{{id}}" {{#if (eq id ../pageCategory)}}selected{{/if}}>{{name}}</option>
            {{/each}}
          </select>
        </label>
      {{/if}}

      <label
        class="ffxiv-editor-page-setting ffxiv-editor-page-setting--icon ffxiv-class-summary-editor__page-setting ffxiv-class-summary-editor__page-setting--icon"
        title="{{localize 'FFXIVTTRPGLayout.ClassSummary.Level'}}"
        aria-label="{{localize 'FFXIVTTRPGLayout.ClassSummary.Level'}}">
        <i class="fa-solid fa-list-tree" aria-hidden="true"></i>
        <select name="title.level">
          {{#each headingLevels}}
            <option value="{{value}}" {{#if (eq value ../pageTitleLevel)}}selected{{/if}}>{{label}}</option>
          {{/each}}
        </select>
      </label>

      <label class="ffxiv-editor-page-setting ffxiv-editor-page-setting--checkbox ffxiv-class-summary-editor__page-setting ffxiv-class-summary-editor__page-setting--checkbox">
        <span>{{localize "FFXIVTTRPGLayout.ClassSummary.DisplayPageTitle"}}</span>
        <input type="checkbox" name="title.show" {{#if pageTitleShow}}checked{{/if}}>
      </label>
    </div>
  </section>

  <section class="ffxiv-class-summary-editor__introduction-field">
    <div class="ffxiv-class-summary-editor__introduction-heading">
      <span class="ffxiv-class-summary-editor__introduction-label">
        <i class="fa-solid fa-book-open" aria-hidden="true"></i>
        <span>{{localize "FFXIVTTRPGLayout.ClassSummary.Introduction"}}</span>
      </span>
    </div>

    <div class="ffxiv-class-summary-editor__introduction-preview">
      {{#if introductionHTML}}
        {{{introductionHTML}}}
      {{else}}
        <span class="ffxiv-empty-state ffxiv-class-summary-editor__introduction-empty">
          {{introductionEmptyLabel}}
        </span>
      {{/if}}
    </div>

    {{#if isEditable}}
      <button
        type="button"
        class="ffxiv-action-button ffxiv-class-summary-editor__edit-introduction"
        data-action="openIntroductionEditor"
        title="{{localize 'FFXIVTTRPGLayout.ClassSummary.EditIntroduction'}}">
        <i class="fa-solid fa-pen-to-square" aria-hidden="true"></i>
        <span>{{localize "FFXIVTTRPGLayout.ClassSummary.EditIntroduction"}}</span>
      </button>
    {{/if}}
  </section>

  <section class="ffxiv-class-summary-editor__jobs-field">
    <div class="ffxiv-class-summary-editor__jobs-heading">
      <span class="ffxiv-class-summary-editor__jobs-label">
        <i class="fa-solid fa-gem" aria-hidden="true"></i>
        <span>{{jobsLabel}}</span>
      </span>
    </div>

    {{#if hasSelectedJobs}}
      <div class="ffxiv-class-summary-editor__selected-jobs">
        {{#each selectedJobs}}
          <div class="ffxiv-class-summary-editor__selected-job" data-job-uuid="{{uuid}}">
            {{#if img}}
              <img src="{{img}}" alt="" class="ffxiv-class-summary-editor__job-icon">
            {{/if}}
            <div class="ffxiv-class-summary-editor__job-info">
              <strong>{{name}}</strong>
              {{#if level}}<span class="ffxiv-class-summary-editor__job-level">LV {{level}}</span>{{/if}}
            </div>
            {{#if ../isEditable}}
              <button
                type="button"
                class="ffxiv-class-summary-editor__remove-job"
                data-action="removeJob"
                data-job-uuid="{{uuid}}"
                title="{{localize 'FFXIVTTRPGLayout.ClassSummary.RemoveJob'}}"
                aria-label="{{localize 'FFXIVTTRPGLayout.ClassSummary.RemoveJobFor'}} {{name}}">
                <i class="fa-solid fa-xmark"></i>
              </button>
            {{/if}}
          </div>
        {{/each}}
      </div>
    {{/if}}

    <div
      class="ffxiv-class-summary-editor__job-dropzone"
      data-class-summary-job-drop
      role="region"
      aria-label="{{localize 'FFXIVTTRPGLayout.ClassSummary.DropAnotherJob'}}">
      <div class="ffxiv-class-summary-editor__drop-prompt">
        <i class="fa-solid fa-arrow-down"></i>
        <span>{{localize "FFXIVTTRPGLayout.ClassSummary.DropAnotherJob"}}</span>
      </div>
    </div>
  </section>
</div>
